# -------------------------------------------------------------
#                    DATABASE CONFIGURATION                   #
# -------------------------------------------------------------
# This file is intentionally sanitized for public use.
# Replace these values with your own local or cloud configuration.
# HOST="database.example.internal"
# DATABASE="message_relay"
# USERNAME="app_user"
# PORT=3306

# -------------------------------------------------------------
#                      AWS CONFIGURATION                      #
# -------------------------------------------------------------
# SECRET_ID="message-relay-db-creds"
# AWS_VPC_SECURITY_GROUP="sg-xxxxxxxxxxxxxxxxx"
# AWS_VPC_SUBNET_1="subnet-xxxxxxxxxxxxxxxxx"
# AWS_VPC_SUBNET_2="subnet-xxxxxxxxxxxxxxxxx"

# - AWS_SQS_STAGE - defines the deployment stage for the app.
# Possible values are: production, preprod, dev, demo, test
AWS_SQS_STAGE="production"
AWS_SQS_REGION="us-east-1"
AWS_SQS_API_VERSION="2012-11-05"
AWS_SQS_MESSAGE_DELAY="300"

SERVICE="message-relay"

# Optional invoker configuration for local or integration workflows
# INVOKER_PYTHON_LAMBDA="message-relay-dev-invoker"
