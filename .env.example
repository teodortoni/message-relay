# -- Service -- #
SERVICE="message-relay"
SECRET_ID="message-relay-db-creds"

# -- Queue Params -- #
AWS_SQS_STAGE="demo"
AWS_SQS_REGION="us-east-1"
AWS_SQS_API_VERSION="2012-11-05"
AWS_SQS_MESSAGE_DELAY="300"

# -- VPC Params -- #
AWS_VPC_SECURITY_GROUP="sg-xxxxxxxxxxxxxxxxx"
AWS_VPC_SUBNET_1="subnet-xxxxxxxxxxxxxxxxx"
AWS_VPC_SUBNET_2="subnet-xxxxxxxxxxxxxxxxx"

# -- Python Lambda Function to Invoke -- #
INVOKER_PYTHON_LAMBDA="message-relay-dev-invoker"